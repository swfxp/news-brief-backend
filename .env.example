# DeepSeek API 密钥（非 dry-run 模式必填）
DEEPSEEK_API_KEY=

# DeepSeek API 地址与模型（默认值如下，一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 新闻源（可选）。留空则使用默认双源：BBC News + The Guardian（均为官方 RSS）。
# 格式：逗号分隔的 "名称=URL"，名称可省略。
# RSS_FEEDS="BBC News=https://feeds.bbci.co.uk/news/world/rss.xml,The Guardian=https://www.theguardian.com/world/rss"
RSS_FEEDS=

# 时间窗口（小时）与每个来源最多选取条数
NEWS_WINDOW_HOURS=24
MAX_ARTICLES=5

# 事件归组（group_events.py）每个来源的候选上限，默认 30
MAX_CANDIDATES=30
